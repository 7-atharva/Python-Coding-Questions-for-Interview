# Reverse String
# 1 approch using slicing
text = input("Enter a String : ") 
print("Reversed String : ",text[::-1]) 

# 2 using mordern Charachter
text = input("Enter a String: ")
reversed_text = ""
# Add each character to the FRONT of the new string
for char in text:
    reversed_text = char + reversed_text
print("Reversed String:", reversed_text)

# 3 using for loop
text = input("Enter a String : ")
reversed_str = ""
for i in range(len(text) -1, -1, -1):  # loop -1 length last index (starrting point), -1 ending point (it include 0), -1 loop is in -- or ++
    reversed_str += text[i]
print("reversed_str : ", reversed_str) 


